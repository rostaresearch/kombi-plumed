# Run from examples/ with one particle; this file supplies physical AND adaptive forces.
# Initial parameters are a documented deterministic example, not a historical walker seed.
UNITS LENGTH=nm ENERGY=kcal/mol TIME=ps
LOAD FILE=../build/Kombi.so
INCLUDE FILE=potential_1d.dat
k: KOMBI ...
 ARG=p.x GRID_MODE=LEGACY_1D GRID_MIN=0 GRID_MAX=6.283185307179586 BINS=100 TARGET=5.2
 AMP_MIN=.1 AMP_MAX=1.2 SIGMA_MIN=.6 SIGMA_MAX=5
 RANDOM_AMP=.6 RANDOM_SIGMA_MIN=.6 RANDOM_SIGMA_MAX=2
 KBT=.5961612777 TILT_KBT=.5981 NGAUSSIANS=20 PACE=5000 LAG=1 SAMPLE_STRIDE=1
 STOP_AT_TARGET TARGET_RADIUS=.1
 RANDOM_TRIALS=1000 MAX_ITER=15000 TOL=.0001 SEED=20261103
 INITIAL_PARAMS=0.041840000000000002,0.041840000000000002,0.041840000000000002,0.041840000000000002,0.041840000000000002,0.041840000000000002,0.041840000000000002,0.041840000000000002,0.041840000000000002,0.041840000000000002,0.041840000000000002,0.041840000000000002,0.041840000000000002,0.041840000000000002,0.041840000000000002,0.041840000000000002,0.041840000000000002,0.041840000000000002,0.041840000000000002,0.041840000000000002,4.4543419371322273,6.0581667475722574,3.5806050472975546,5.354133700272306,4.4952698178929404,0.47294546872308929,1.9107601171950555,4.9921351037247019,4.4990877348611882,4.7659526753445896,2.7411308788494044,5.5218291871505754,0.75974901680336104,0.00084087411370334212,2.3938052430537047,5.6063929461231004,4.6848684501248332,3.4409815257531702,4.8018246262876003,0.54371278329710038,1.4925217753107605,6.0972336387398061,3.551428863903531,3.7572212064467365,4.762600208633315,2.0893066326441616,1.1786045606450253,2.6777312306646084,5.0078150672180497,3.3524769383382793,1.5302379360529816,1.3349137049899849,2.9665840094235265,5.7345434724058109,2.5198585540321612,0.63451633464172785,0.38100501713002627,0.24031752960334224,4.6235164810174219,1.1985009268994893
