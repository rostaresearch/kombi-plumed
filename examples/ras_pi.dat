# Ras Pi A5/L20 example. Atom IDs are ONLY for the original step3 topology.
# Verify Mg=7800 and phosphate P=7841 against YOUR topology (PLUMED is 1-based).
# Minimum-image distance follows the current 73-run periodic Ras campaign.
# At 2 fs, PACE=10000 is 20 ps. The MD engine supplies the physical force field.
UNITS LENGTH=A ENERGY=kcal/mol TIME=ps
LOAD FILE=../build/Kombi.so
d: DISTANCE ATOMS=7800,7841
k: KOMBI ...
 ARG=d GRID_MODE=RAS GRID_MIN=1 GRID_MAX=8 BINS=100 TARGET=8
 KBT=.5961612777 TILT_KBT=.5981 NGAUSSIANS=10 PACE=10000 LAG=1 SAMPLE_STRIDE=1
 STOP_AT_TARGET
 AMP_MIN=.1 AMP_MAX=5 SIGMA_MIN=.7 SIGMA_MAX=2
 RANDOM_AMP=.6 RANDOM_SIGMA_MIN=.7 RANDOM_SIGMA_MAX=1
 RANDOM_TRIALS=1000 MAX_ITER=15000 TOL=.000001 SEED=20261103
 INITIAL_PARAMS=0.01,0.01,0.01,0.01,0.01,0.01,0.01,0.01,0.01,0.01,3.8454060288323686,3.8465363377046899,3.6473616035336049,3.8873621586131502,3.8742995400118532,3.6838864320974114,3.8850361010595793,3.7690876694577868,3.8604844131653469,3.8203618423473489,1.9698138032759305,2.766409832759821,2.6163982272606834,2.5710932455338953,1.0503313464484774,2.7705304290157371,3.8687358673732861,4.1070376996360682,3.6949168990979233,3.9338157284694693
 STATE_FILE=ras_pi.state HISTORY_FILE=ras_pi.history CHECKPOINT_STRIDE=10000
...
PRINT ARG=d,k.bias,k.mfpt,k.window,k.fpt FILE=ras_pi.COLVAR STRIDE=1 FMT=%24.17g
